ENVIRONMENT=development
INSTANCE_ID=local
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://policydesk:policydesk@localhost:55432/policydesk
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RUN_WORKER_IN_PROCESS=false

JWT_SECRET=replace-with-a-long-random-string
INTERNAL_TOOLS_SECRET=replace-with-another-long-random-string

AI_BACKEND=stub
EMBED_BACKEND=stub
RETRIEVER=pgvector
AGENT_MODE=local
FALLBACK_BACKEND=none
MIN_RELEVANCE=0.12
CHUNK_STRATEGY=hierarchical

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

COHERE_API_KEY=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_KB_ID=
BEDROCK_KB_DATA_SOURCE_ID=
BEDROCK_KB_SEARCH_TYPE=DEFAULT
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
S3_BUCKET=

DAILY_TOKEN_BUDGET=200000
AWS_ENABLED=true
AWS_DAILY_USD_LIMIT=0.50
PROVIDER_MAX_RETRIES=2
CIRCUIT_MAX_FAILURES=5
CIRCUIT_WINDOW_S=120
CIRCUIT_COOLDOWN_S=600
MAX_TOKENS=700
MAX_CONTEXT_CHARS=8000
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=10
CACHE_TTL_S=3600
